{
  "name": "vsversions",
  "version": "1.0.50",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build --compile --minify-whitespace --minify-syntax --outfile server src/index.ts",
    "auth:generate": "bun x --bun auth@latest generate --config src/auth.ts --output src/db/schema.ts --dialect sqlite --adapter drizzle -y && bun db:generate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/cron": "^1.4.2",
    "@libsql/client": "^0.18.0",
    "better-auth": "^1.7.7",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.3",
    "elysia": "1.4.30",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "bun-types": "1.4.2",
    "dotenv": "^18.0.5",
    "drizzle-kit": "0.31.11",
    "tsx": "^4.23.15"
  },
  "module": "src/index.js"
}
